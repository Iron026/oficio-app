rules_version = '2';

// Regras de segurança do Ofício.
// Princípio: cada conta acessa SOMENTE os próprios dados (users/{uid}).
// Tudo o que não está explicitamente permitido é negado.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // 0.4 — selo permanente: estágio 1..4 que nunca diminui e nunca é excluído
    // individualmente (só some com a exclusão da conta inteira).
    function validSealAward() {
      let r = request.resource.data;
      return r.deleted == false
        && r.id in ['constancia', 'fidelizacao', 'metas', 'experiencia', 'carteira', 'saude']
        && r.data.keys().hasOnly(['id', 'stage', 'reachedAt', 'createdAt', 'updatedAt'])
        && r.data.stage is int && r.data.stage >= 1 && r.data.stage <= 4
        && r.data.reachedAt is list && r.data.reachedAt.size() <= 4
        && r.data.createdAt is string && r.data.updatedAt is string
        && (resource == null || resource.data.deleted == true || r.data.stage >= resource.data.data.stage);
    }

    // 0.4 — foto de perfil: um único documento ("atual"), WebP ou JPEG, até 64 KiB
    // (87 384 caracteres em base64), lado de 128 a 512 px. Pode ser removida (lápide).
    function validProfileImage() {
      let r = request.resource.data;
      return r.id == 'atual'
        && (r.deleted == true || (
          r.data.keys().hasOnly(['id', 'mime', 'data', 'bytes', 'width', 'height', 'hash', 'createdAt', 'updatedAt'])
          && r.data.mime in ['image/webp', 'image/jpeg']
          && r.data.data is string && r.data.data.size() > 0 && r.data.data.size() <= 87384
          && r.data.bytes is int && r.data.bytes > 0 && r.data.bytes <= 65536
          && r.data.width is int && r.data.width >= 128 && r.data.width <= 512
          && r.data.height is int && r.data.height >= 128 && r.data.height <= 512
          && r.data.hash is string && r.data.hash.size() > 0 && r.data.hash.size() <= 128
          && r.data.createdAt is string && r.data.updatedAt is string));
    }

    // Revisão: criação começa em 1; atualização exige exatamente +1
    // (controle de concorrência: evita sobrescrever alterações de outro aparelho).
    function validRev() {
      return request.resource.data.rev is int
        && (resource == null
              ? request.resource.data.rev == 1
              : request.resource.data.rev == resource.data.rev + 1);
    }

    // Perfil e preferências da conta.
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['schemaVersion', 'data', 'rev', 'updatedAt', 'deviceId'])
        && request.resource.data.data is map
        && request.resource.data.updatedAt == request.time
        && request.resource.data.deviceId is string
        && request.resource.data.deviceId.size() <= 64
        && validRev();

      // Registros: clientes, serviços, lançamentos, XP e conquistas.
      match /records/{recordId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['collection', 'id', 'data', 'deleted', 'rev', 'updatedAt', 'deviceId'])
          && request.resource.data.collection in ['clients', 'appointments', 'transactions', 'xpEvents', 'achievements', 'sealAwards', 'profileImages']
          && request.resource.data.id is string
          && request.resource.data.id.size() <= 128
          && recordId == request.resource.data.collection + '__' + request.resource.data.id
          && request.resource.data.deleted is bool
          && (request.resource.data.deleted
                ? request.resource.data.data == null
                : (request.resource.data.data is map && request.resource.data.data.id == request.resource.data.id))
          && request.resource.data.updatedAt == request.time
          && request.resource.data.deviceId is string
          && request.resource.data.deviceId.size() <= 64
          && validRev()
          && (request.resource.data.collection != 'sealAwards' || validSealAward())
          && (request.resource.data.collection != 'profileImages' || validProfileImage());
      }

      // Direitos Premium (futuro): somente leitura pelo app. A gravação será feita
      // apenas por um servidor após verificar a compra no Google Play Billing.
      // O login Google, sozinho, nunca concede Premium.
      match /entitlements/{doc} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
